<ui:FluentWindow
        x:Class="BKFluentChat.Views.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BKFluentChat.Views.Windows"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BKFluentChat.ViewModels.Windows" 
        d:DataContext="{d:DesignInstance local:SearchWindow,
                                   IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="SearchWindow" Height="450" Width="800">
 

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题栏 -->
            <RowDefinition Height="*" />
            <!-- 内容 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Title="综合搜索" Grid.Row="0" />

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 搜索栏 -->
                <RowDefinition Height="Auto"/>
                <!-- Tab 栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 标签栏 -->
                <RowDefinition Height="*"/>
                <!-- 结果列表 -->
            </Grid.RowDefinitions>

            <!-- 搜索栏 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="123456}" PlaceholderText="输入搜索关键词" Icon="{ui:SymbolIcon Search24}"/>
                <ui:Button Content="搜索" Grid.Column="1" Margin="10,0,0,0"/>
            </Grid>

            <!-- Tab 栏 (简化版) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15">
                <Button Content="全部" />
                <Button Content="用户" Margin="10,0,0,0"/>
                <Button Content="群聊" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 结果列表 -->
            <ListView Grid.Row="3" ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchResult}">
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="48" Height="48">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatar}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding MemberCount, StringFormat={}👥 {0}}" Foreground="Gray" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Status}" Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="加入" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ui:FluentWindow>
