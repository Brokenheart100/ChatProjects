{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp.ReverseProxy": "Debug"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Issuer": "https://authservice.chatapp.com",
        "Audience": "https://api.chatapp.com",
        "SecretKey": "THIS_IS_A_SUPER_SECRET_KEY_FOR_JWT_32_CHARS_LONG"
    },
    "ReverseProxy": {
      "Routes": {
        "auth-route": {
          "ClusterId": "auth-cluster",
          "Match": {
            "Path": "/gateway/auth/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/auth/{**catch-all}"
            }
          ]
        },
        "profile-route": {
          "ClusterId": "user-cluster",
          "AuthorizationPolicy": "Default",
          "Match": {
            "Path": "/gateway/profile/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/profile/{**catch-all}"
            }
          ]
        },
        "files-route": {
          "ClusterId": "file-cluster",
          //"AuthorizationPolicy": "Default", // 上传文件通常需要登录
          "Match": {
            "Path": "/gateway/files/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/files/{**catch-all}"
            }
          ]
        },
        "search-route": {
          "ClusterId": "search-cluster",
          "AuthorizationPolicy": "Default", // 搜索通常需要登录
          "Match": {
            "Path": "/gateway/search/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/search/{**catch-all}"
            }
          ]
        },
        // --- 核心新增：为好友功能添加新的路由 ---
        "friends-route": {
          "ClusterId": "user-cluster", // 好友功能在 UserService 中，所以指向 user-cluster
          "AuthorizationPolicy": "Default", // 发送好友请求需要登录
          "Match": {
            "Path": "/gateway/friends/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/friends/{**catch-all}"
            }
          ]
        },
        "realtimeservice-route": {
          "ClusterId": "realtimeservice-cluster",
          "Match": { "Path": "/gateway/chathub/{**catch-all}" }, // 匹配 SignalR 路由
          "Transforms": [ { "PathPattern": "/chathub/{**catch-all}" } ]
        },
        "conversations-route": {
          "ClusterId": "chathistory-cluster",
          "Match": {
            "Path": "/gateway/conversations/{**catch-all}"
          },
          "Transforms": [
            { "PathPattern": "/api/conversations/{**catch-all}" }
          ]
        },
        "messages-route": {
          "ClusterId": "chathistory-cluster",
          "Match": {
            "Path": "/gateway/messages/{**catch-all}"
          },
          "Transforms": [
            { "PathPattern": "/api/messages/{**catch-all}" }
          ]
        },
        "groups_route": {
          "ClusterId": "chathistory-cluster", // 确保这里指向 ChatHistoryService 的 Cluster ID
          "Match": {
            "Path": "/gateway/groups/{**catch-all}"
          },
          "Transforms": [
            { "PathPattern": "/api/groups/{**catch-all}" }
          ]
        }
      },
      "Clusters": {
        "auth-cluster": {
          "Destinations": {
            "destination1": {
              "Address": "https://authservice"
            }
          }
        },
        "user-cluster": {
          "Destinations": {
            "destination1": {
              "Address": "https://userservice"
            }
          }
        },
        "file-cluster": {
          "Destinations": {
            "destination1": {
              "Address": "http://fileservice"
            }
          }
        },
        "search-cluster": {
          "Destinations": {
            "destination1": {
              "Address": "http://searchservice"
            }
          }
        },
        "chathistory-cluster": {
          "Destinations": {
            "destination1": {
              "Address": "http://chathistoryservice"
            }
          }
        },
        "realtimeservice-cluster": {
          "Destinations": {
            "destination1": { "Address": "http://realtimeservice" }
          }
        }

      }
      }
   }