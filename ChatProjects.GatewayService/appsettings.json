{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://authservice.chatapp.com",
    "Audience": "https://api.chatapp.com",
    "SecretKey": "THIS_IS_A_SUPER_SECRET_KEY_FOR_JWT_32_CHARS_LONG"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/gateway/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "profile-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/gateway/profile/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/profile/{**catch-all}" }
        ]
      },
      "files-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/gateway/files/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/files/{**catch-all}" }
        ]
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/gateway/search/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/search/{**catch-all}" }
        ]
      },
      "friends-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/gateway/friends/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/friends/{**catch-all}" }
        ]
      },

      // ✅✅✅ [核心修复] 新增：用户查询路由 ✅✅✅
      // 这将处理 /gateway/users/batch 等请求
      "users_route": {
        "ClusterId": "user-cluster", // 注意：这里必须填 "user-cluster" (单数)，因为下面的 Clusters 里定义的是单数
        "Match": {
          "Path": "/gateway/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ]
      },
      // -------------------------------------------------

      "realtimeservice-route": {
        "ClusterId": "realtimeservice-cluster",
        "Match": { "Path": "/gateway/chathub/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/chathub/{**catch-all}" } ]
      },
      "conversations-route": {
        "ClusterId": "chathistory-cluster",
        "Match": {
          "Path": "/gateway/conversations/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/conversations/{**catch-all}" }
        ]
      },
      "messages-route": {
        "ClusterId": "chathistory-cluster",
        "Match": {
          "Path": "/gateway/messages/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/messages/{**catch-all}" }
        ]
      },
      "groups_route": {
        "ClusterId": "chathistory-cluster",
        "Match": {
          "Path": "/gateway/groups/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/groups/{**catch-all}" }
        ]
      },
      "status_route": {
        "ClusterId": "realtimeservice-cluster", // 指向 RealtimeService
        "Match": {
          "Path": "/gateway/status/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/status/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://authservice" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://userservice" }
        }
      },
      "file-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://fileservice" }
        }
      },
      "search-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://searchservice" }
        }
      },
      "chathistory-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://chathistoryservice" }
        }
      },
      "realtimeservice-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://realtimeservice" }
        }
      }
    }
  }
}